---
import Base from './Base.astro'
import FirmaMedica from '../components/FirmaMedica.astro'
import Galeria from '../components/Galeria.astro'
import { CLINICAS, SITIO } from '../datos/sitio.js'

const { datos, seccion, enlaceSeccion, relacionadas = [], entradilla = '', jsonLdExtra = [], autor = 'Dr. Juan Cabrera Garrido', cargo = 'Cirujano vascular' } = Astro.props
const fm = datos.frontmatter
const principal = CLINICAS[0]
const tituloSeo = fm.tituloCorto || fm.titulo
const tituloEtiqueta = fm.tituloSeo2 || tituloSeo
const migasLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITIO.url + '/' },
    { '@type': 'ListItem', position: 2, name: seccion, item: new URL(enlaceSeccion, SITIO.url).href },
    { '@type': 'ListItem', position: 3, name: tituloSeo },
  ],
}
const tieneImagenesClinicas = (fm.imagenes?.length ?? 0) > 0 || (fm.galeria?.length ?? 0) > 0

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: fm.titulo,
  description: fm.descripcion || entradilla,
  url: new URL(Astro.url.pathname, SITIO.url).href,
  inLanguage: 'es',
  reviewedBy: {
    '@type': 'Physician',
    name: autor,
    medicalSpecialty: 'Phlebology',
  },
}
---
<Base titulo={`${tituloEtiqueta} · ${SITIO.nombre}`.length > 62 ? tituloEtiqueta : `${tituloEtiqueta} · ${SITIO.nombre}`} descripcion={fm.descripcion || entradilla} jsonLd={[jsonLd, migasLd, ...[].concat(jsonLdExtra)]}>
  <nav class="migas ui envoltorio" aria-label="Migas de pan">
    <a href="/">Inicio</a><span aria-hidden="true">/</span>
    <a href={enlaceSeccion}>{seccion}</a><span aria-hidden="true">/</span>
    <span aria-current="page">{tituloSeo}</span>
  </nav>

  <div class="encabezado envoltorio">
    <div>
      <span class="rotulo">{seccion}</span>
      <h1>{tituloSeo}</h1>
      {entradilla && <p class="encabezado__entradilla">{entradilla}</p>}
    </div>
    <FirmaMedica autor={autor} cargo={cargo} />
  </div>

  <div class="cuerpo envoltorio">
    <article class="prosa">
      <datos.Content />
      <Galeria fotos={fm.galeria ?? []} />
      {tieneImagenesClinicas && (
        <p class="aviso-legal-sanitaria aviso-imagenes">
          Imágenes de casos reales cedidas por pacientes. Los resultados varían en función de cada persona y no
          constituyen una garantía de resultado. Publicidad sanitaria sujeta al Real Decreto 1907/1996.
          [PENDIENTE: confirmar que se conservan los consentimientos informados de cada imagen antes de publicar.]
        </p>
      )}
      <section class="fuentes">
        <span class="rotulo">Referencias y fuentes</span>
        <p class="ui">[PENDIENTE: bibliografía de respaldo. Texto migrado literalmente de {fm.origen}.]</p>
      </section>
    </article>

    <aside class="lateral">
      <div class="lateral__cta">
        <h2>¿Tu caso es tratable?</h2>
        <p class="ui">Pide una primera consulta con eco-doppler y te decimos qué venas hay que tratar.</p>
        <a class="boton lateral__boton" href="/contacto/">Contacto</a>
        <a class="boton-sec lateral__boton lateral__boton--claro" href={`tel:${principal.telefonoE164}`}>{principal.telefonos[0]}</a>
      </div>

      {relacionadas.length > 0 && (
        <nav class="lateral__bloque" aria-label="Relacionadas">
          <span class="rotulo">Relacionadas</span>
          <div class="lateral__lista ui">
            {relacionadas.map((r) => <a href={r.url}>{r.nombre}</a>)}
          </div>
        </nav>
      )}

      <div class="lateral__bloque">
        <span class="rotulo">Dónde tratarte</span>
        <div class="lateral__lista ui">
          {CLINICAS.map((c) => (
            <a class="lateral__clinica" href={`/clinicas/${c.slug}/`}><span>{c.nombre}</span><span>{c.telefonos[0]}</span></a>
          ))}
        </div>
      </div>
    </aside>
  </div>
</Base>

<style>
  .migas { display: flex; align-items: center; gap: .6rem; padding-block: 1rem; border-bottom: 1px solid var(--linea-2); font-size: .78rem; color: var(--tinta-4); }
  .migas a { color: var(--tinta-4); }
  .migas [aria-current] { color: var(--tinta); font-weight: 600; }

  .encabezado { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 4.5rem; align-items: end; padding-block: 3.5rem 2.5rem; }
  .encabezado .rotulo { display: block; margin-bottom: 1.2rem; }
  .encabezado__entradilla { margin-top: 1.4rem; font-size: 1.25rem; line-height: 1.55; color: var(--tinta-3); max-width: 44ch; }

  .cuerpo { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 5.5rem; padding-block: 2.5rem 5rem; border-top: 1px solid var(--linea); }

  .aviso-imagenes { margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid var(--linea-2); }
  .fuentes { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--linea); }
  .fuentes p { margin-top: .6rem; font-size: .85rem; color: var(--tinta-4); }

  .lateral { display: flex; flex-direction: column; gap: 2.2rem; align-self: start; position: sticky; top: 110px; }
  .lateral__cta { padding: 1.7rem; background: var(--tinta); color: var(--papel); }
  .lateral__cta h2 { font-size: 1.6rem; color: var(--papel); }
  .lateral__cta p { margin: .8rem 0 1.2rem; font-size: .9rem; line-height: 1.6; color: #9AA7B3; }
  .lateral__boton { width: 100%; min-height: 54px; background: var(--papel); color: var(--tinta); border-color: var(--papel); }
  .lateral__boton--claro { margin-top: .6rem; background: transparent; color: var(--papel); border-color: #33475C; }
  .lateral__boton--claro:hover { background: var(--papel); color: var(--tinta); }
  .lateral__bloque { display: flex; flex-direction: column; gap: .8rem; }
  .lateral__lista { display: flex; flex-direction: column; }
  .lateral__lista a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 46px; padding-block: .6rem; border-top: 1px solid var(--linea-2); font-size: .9rem; color: var(--tinta); }
  .lateral__lista a:last-child { border-bottom: 1px solid var(--linea-2); }
  .lateral__clinica span:last-child { color: var(--tinta-4); }

  @media (max-width: 1080px) {
    .encabezado, .cuerpo { grid-template-columns: 1fr; gap: 2.5rem; }
    .lateral { position: static; }
  }
</style>
